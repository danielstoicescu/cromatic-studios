{
 "canvas": {
  "w": 1080,
  "h": 1920,
  "fps": 30,
  "lottieFps": 60
 },
 "safe": {
  "top": 250,
  "bottom": 340,
  "side": 80,
  "note": "Stories: progress bar + handle on top, reply bar at the bottom. Reels: also keep right-aligned words out of x > 900 between y 1100 and 1580 (the like / comment column)."
 },
 "anchors": {
  "left": 80,
  "right": 1000,
  "centre": 540,
  "topCap": 300,
  "bottomBase": 1530,
  "middle": 960
 },
 "colour": {
  "paper": "#FBFAF5",
  "ink": "#0D0C09",
  "yellow": "#FED012",
  "white": "#FFFFFF",
  "black": "#000000"
 },
 "rule": "One text colour per card: paper on night/dark scenes, ink on light scenes and on the aplat. No letter or word in another colour. The pill and the aplat are objects, not type: the word in a pill is always ink.",
 "face": {
  "display": {
   "family": "Google Sans",
   "cssFamily": "CromaticSans, 'Google Sans'",
   "weight": 600,
   "file": "site/fonts/google-sans-latin.woff2",
   "note": "The site's display face (the 18pt SemiBold cut the map, the intro and the welcome card are drawn with). One face for every word in the stories; no mono counters, no second family."
  }
 },
 "type": {
  "hero": {
   "size": 336,
   "lead": 0.92,
   "tracking": -0.05,
   "use": "one word that is the shot (SLOW)"
  },
  "headline": {
   "size": 168,
   "lead": 0.94,
   "tracking": -0.045,
   "use": "the short punches: Take your drive. / Night coffee hopping. / Ended too soon?"
  },
  "title": {
   "size": 116,
   "lead": 1,
   "tracking": -0.04,
   "use": "statements of one or two lines; the word-in-pill lines"
  },
  "line": {
   "size": 88,
   "lead": 1.06,
   "tracking": -0.035,
   "use": "a sentence that leads into the end (Drive it for yourself.)"
  },
  "lead": {
   "size": 60,
   "lead": 1.1,
   "tracking": -0.025,
   "use": "the small line that sets up a big one (You should take it)"
  },
  "tag": {
   "size": 44,
   "lead": 1,
   "tracking": -0.01,
   "use": "address tags only"
  },
  "url": {
   "size": 64,
   "lead": 1,
   "tracking": -0.02,
   "use": "the cromaticstudios.com pill"
  }
 },
 "pill": {
  "height": 1.16,
  "padX": 0.34,
  "gap": 0.24,
  "extraLead": 0.2,
  "centreFromBaseline": 0.355,
  "keyline": 0.045,
  "shadow": [
   0.03,
   0.065
  ],
  "tilt": -3,
  "fill": {
   "onScene": "#FED012",
   "onAplat": "#FFFFFF"
  },
  "ink": "#0D0C09",
  "note": "height, padX, gap (after the words before it), extraLead (added to the lead of the line that carries it), keyline and shadow in em of the line's size. Full radius. Tilt about its left end (the end that stays put when the word swaps); the words around it stay level."
 },
 "aplat": {
  "radius": 30,
  "keyline": 5,
  "shadow": [
   0,
   12
  ],
  "padX": 52,
  "padTop": 46,
  "padBottom": 50,
  "tilt": -2,
  "fill": "#FED012",
  "note": "The block and everything on it turn together about the block's top-left corner. The text on it is ink; a pill on it is white."
 },
 "tag": {
  "size": 44,
  "height": 84,
  "padL": 26,
  "dot": 22,
  "dotGap": 16,
  "padR": 32,
  "keyline": 4,
  "dotKeyline": 3.5,
  "shadow": [
   0,
   7
  ],
  "pointer": {
   "x": 46,
   "w": 30,
   "h": 18
  },
  "plate": "#FFFFFF",
  "ink": "#0D0C09",
  "dotFill": "#FED012",
  "note": "Name · time, one line, never more than ~22 characters. Straight (no tilt): it is information, not a title."
 },
 "url": {
  "text": "cromaticstudios.com",
  "size": 64,
  "padX": 0.625,
  "height": 1.6,
  "keyline": 6,
  "shadow": [
   10,
   14
  ],
  "tilt": -6,
  "centre": [
   540,
   1000
  ],
  "fill": "#FED012",
  "ink": "#0D0C09",
  "note": "The end card: alone on black, centred, in every story. It never moves when the screen goes black."
 },
 "motion": {
  "lineIn": {
   "kind": "rise out of the baseline (a mask on the line)",
   "frames": 12,
   "letterStagger": 0.6,
   "lineStagger": 4,
   "ease": [
    0.16,
    1,
    0.3,
    1
   ]
  },
  "lineOut": {
   "kind": "up and out of the same mask",
   "frames": 7,
   "letterStagger": 0.35,
   "ease": [
    0.7,
    0,
    0.84,
    0
   ]
  },
  "pillIn": {
   "kind": "pops on its centre, 60 % -> 100 %, tilt -9 -> -3",
   "frames": 10,
   "ease": [
    0.34,
    1.56,
    0.64,
    1
   ]
  },
  "pillSwap": {
   "kind": "the width rolls to the next word (left edge fixed), the old word rises out, the new one rises in",
   "frames": 8,
   "ease": [
    0.16,
    1,
    0.3,
    1
   ]
  },
  "aplatIn": {
   "kind": "swings in from its top-left corner: rotate -7 -> -2, y -24 -> 0, opacity 0 -> 100 in 3",
   "frames": 14,
   "ease": [
    0.34,
    1.56,
    0.64,
    1
   ]
  },
  "aplatMove": {
   "kind": "the whole card glides to its next placement",
   "frames": 12,
   "ease": [
    0.65,
    0,
    0.35,
    1
   ]
  },
  "tagIn": {
   "kind": "lands on its pointer: scale 40 % -> 100 % about the pointer's tip",
   "frames": 9,
   "ease": [
    0.34,
    1.56,
    0.64,
    1
   ]
  },
  "tagOut": {
   "kind": "scale 100 % -> 0 % about the pointer's tip",
   "frames": 6,
   "ease": [
    0.7,
    0,
    0.84,
    0
   ]
  },
  "smashCut": {
   "kind": "on and off with the frame (SLOW only)",
   "frames": 0
  },
  "urlIn": {
   "kind": "up from +260 px with the house bounce, tilt -24 -> -6, a squash 104/96 -> 98/102 -> 100",
   "frames": 20
  },
  "urlSettle": {
   "kind": "the soft last move on black: tilt -6 -> -4, scale 100 -> 104",
   "frames": 30,
   "ease": [
    0.65,
    0,
    0.35,
    1
   ]
  },
  "holdRule": "A line holds at least 18 frames + 1 frame per character. The two long holds Daniel asked for (the fountain, SLOW) hold 75 frames or more."
 },
