diff --git a/src/polite.css b/src/polite.css
new file mode 100644
index 0000000..9716732
--- /dev/null
+++ b/src/polite.css
@@ -0,0 +1,123 @@
+/* Polite City (polite-city branch): the HUD, the loading card, the big-moment cards, the codes. Only while the world is on
+   (body.pc-on, set by src/polite.js). Our own frame, glyphs, type and colours (legal.md §5): the Cromatic display type set
+   italic and tight for loud moments, JetBrains Mono for data, 2M2F's pixel letters on the pager, black outlines and the
+   hard print offset, the beacon pill (coral | blue) as the world's mark, Cromatic's four-point star for Heat */
+.pc-hud { display: none; }
+body.pc-on.map-mode .pc-hud { display: block; }
+.pc-hud > * { position: fixed; z-index: 21; pointer-events: none; }
+.pc-pill { display: inline-block; width: 34px; height: 14px; border-radius: 999px; border: 2.5px solid #141414; background: linear-gradient(90deg, #F65342 50%, #119BFE 50%); box-sizing: border-box; }
+
+/* the radar: a rounded square (not a circle), ink outline, paper keyline, the print offset */
+.pc-radar { left: calc(20px + env(safe-area-inset-left, 0px)); bottom: calc(22px + env(safe-area-inset-bottom, 0px)); transition: bottom .35s cubic-bezier(.3, 1.3, .5, 1); width: 184px; height: 184px; border-radius: 30px; border: 3px solid #141414; box-shadow: inset 0 0 0 3px #F2F2F2, 4px 5px 0 #141414; overflow: hidden; background: #1a1f26; }
+.pc-radar canvas { width: 100%; height: 100%; display: block; border-radius: 27px; }
+.pc-radar .pc-pill { position: absolute; left: 50%; top: 7px; translate: -50% 0; }
+
+/* top right: the real clock, the credits, Heat */
+.pc-stack { right: calc(24px + env(safe-area-inset-right, 0px)); top: 150px; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
+.pc-clock, .pc-cred { display: flex; align-items: baseline; gap: 6px; padding: 6px 12px 7px; border-radius: 999px; border: 2.5px solid #141414; box-shadow: 3px 4px 0 #141414; font: 700 16px/1 "JetBrains Mono", ui-monospace, monospace; letter-spacing: .06em; }
