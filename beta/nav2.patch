+
+/* section heads */
+.sec-head>.prose{padding-top:15px}
+.sec-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,4vw,72px);align-items:start}
+.sec-head h2{font-size:var(--fs-h2);line-height:var(--lh-h2)}
+
+/* problem */
+.problem{background:var(--white)}
