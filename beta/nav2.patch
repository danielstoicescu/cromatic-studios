+.quote--photo{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(24px,4vw,72px);align-items:center;padding:clamp(8px,2vw,32px) 0 0 clamp(0px,5vw,80px)}
