+/* ── r456 · motion. The reel's manner of moving, for every element (refs: mods-constellation/motion-study.md).
+   One step clock (steps(), never a glide), two beats (67 ms and 133 ms). mods.js marks what arrives (.mk-e) and
+   when (.mk-in, --d); html.mk-mo is on only while the mod is on and motion is allowed, so with reduced motion,
+   or without the script, everything is simply there. */
+/* the two canvases that follow the page do it by transform: nothing is laid out again while it scrolls */
+html.m-sky :is(.mk-fx, .mk-route) { position: absolute; left: 0; top: 0; will-change: transform; contain: strict; }
+html.m-sky .mk-fx { z-index: 51; }
+html.m-sky .mk-route { z-index: -1; }
+/* before the script has run: the header and the sentence wait (3 s at most), so nothing shows and then hides
+   again. The headline does not wait: it is painted dim from the first frame and lights when its points land. */
+@keyframes mk-pre { 0%, 100% { opacity: 0; } }
+html.m-sky.mk-pre :is(.hdr-in, .pw-first .f5-say) { animation: mk-pre 3s steps(1, end); }
+html.m-sky.mk-pre .pw-first .pw-h { color: var(--m-dim); }
+/* the site's own reveals rest: nothing slides, tilts or fades here */
+html.m-sky.m-sky .rv:not(.in), html.m-sky.m-sky .bento:not(.in) .bcard, html.m-sky.m-sky .dom-street:not(.in) :is(.street-sign, .sh-sub, .sh-lead, .sh-more), html.m-sky.m-sky.m-sky .crew li { opacity: 1; transform: none; translate: none; }
+html.m-sky :is(.rv, .street-sign, .sh-sub, .sh-lead, .sh-more, .crew li) { transition: none !important; }
+/* a change of state is a cut in two steps */
+html.m-sky :is(a, button, summary, .btn, .bcard, .sv5-head, input, textarea, select) { transition-duration: .1s !important; transition-timing-function: steps(2, end) !important; transition-delay: 0s !important; }
+html.m-sky.m-sky.m-sky.mk-mo .mk-e:not(.mk-in) { opacity: 0; }
+html.m-sky.m-sky.m-sky.mk-mo :is(.pw-h, .ss-name).mk-e:not(.mk-in) { opacity: 1; color: var(--m-dim); }
+/* p · a sentence: there at once, dim, settles 2 px, then lit */
+@keyframes mk-cap { 0% { opacity: 0; translate: 0 2px; } 22% { opacity: .42; translate: 0 2px; } 45%, 100% { opacity: .42; translate: 0 0; } }
+html.m-sky.mk-mo .mk-p.mk-in { animation: mk-cap .3s steps(1, end) var(--d, 0ms) backwards; }
+/* c · a thing with weight: steps in as its star lands */
+@keyframes mk-card { 0% { opacity: 0; } 34% { opacity: .35; } 67%, 100% { opacity: .7; } }
+html.m-sky.mk-mo .mk-c.mk-in { animation: mk-card .2s steps(1, end) var(--d, 0ms) backwards; }
+/* m · a label, a link, a button: typed on, one character a step */
+@keyframes mk-type { from { clip-path: inset(-30% 100% -30% -6px); } to { clip-path: inset(-30% calc(100% - var(--tw, 100%)) -30% -6px); } }
+html.m-sky.mk-mo .mk-m.mk-in { animation: mk-type calc(var(--n, 8) * 40ms) steps(var(--n, 8), end) var(--d, 0ms) backwards; }
+/* h · big type: the points are cut to the letters in dim grey, then the words light one by one */
+@keyframes mk-lit { from { color: var(--m-dim); text-shadow: none; } }
+html.m-sky.mk-mo .mk-h.mk-in :is(.si-w, .mk-wd) { animation: mk-lit 50ms steps(1, end) calc(var(--mi, 0) * var(--mw, 90ms) + 100ms) backwards; }
+/* a street's name is dim for a beat, then its words light one by one, as the headline's do */
+html.m-sky.mk-mo .ss-name.mk-h.mk-in .mk-wd { animation-delay: calc(var(--mi, 0) * 133ms + 250ms); }
+/* what opens: a service, an answer, the menus */
+html.m-sky.mk-mo .sv5-card.on .sv5-body > * { animation: mk-cap .3s steps(1, end) calc(var(--k, 0) * 67ms + 100ms) backwards; }
+html.m-sky.mk-mo details[open] > :not(summary) { animation: mk-cap .3s steps(1, end) backwards; }
+html.m-sky.mk-mo .mm.open :is(.mm-top, .mm-grid > *), html.m-sky.mk-mo .mnav.open :is(a, .mods-mb) { animation: mk-cap .3s steps(1, end) calc(var(--k, 0) * 67ms) backwards; }
+html.m-sky :is(.mm-grid, .mnav, .sv5-body) > :nth-child(2) { --k: 1; }
+html.m-sky :is(.mm-grid, .mnav, .sv5-body) > :nth-child(3) { --k: 2; }
+html.m-sky :is(.mm-grid, .mnav, .sv5-body) > :nth-child(4) { --k: 3; }
+html.m-sky :is(.mm-grid, .mnav, .sv5-body) > :nth-child(5) { --k: 4; }
