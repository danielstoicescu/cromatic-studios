+.mix-prod .frame>img{object-fit:contain;padding:clamp(14px,9%,56px);transform:rotate(var(--tilt,0deg));mix-blend-mode:multiply}
+.mix-prod:hover .frame>img{transform:rotate(0deg) scale(1.04)}
