+.n2-panel { left: 22px; bottom: calc(22px + env(safe-area-inset-bottom, 0px)); width: min(392px, calc(100vw - 44px)); max-height: min(56vh, 520px); overflow: auto; padding: 12px 12px 10px; border-radius: 22px; background: #FFFDF6; color: #141414; border: 2.5px solid #141414; box-shadow: 5px 6px 0 #141414; transition: opacity .3s, translate .35s; overscroll-behavior: contain; scrollbar-width: none; }
