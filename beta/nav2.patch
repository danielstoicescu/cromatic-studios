+/* r138h: the camera with the "Ne știm de la Steam" sticker, next to the line it carries */
+.sb-pair{display:grid;grid-template-columns:minmax(0,max-content) minmax(0,clamp(220px,30%,400px));justify-content:center;gap:clamp(36px,8vw,140px);align-items:center}
