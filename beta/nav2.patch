+.mm-btn { display: none; }
+.js .nav .mm-btn { display: inline-flex; align-items: center; gap: 7px; padding: 6px 0; border: 0; background: linear-gradient(var(--y), var(--y)) 0 100% / 0 3px no-repeat; color: inherit; font: 600 15px/1.6 var(--f); cursor: pointer; transition: background-size .18s var(--eoq); }
