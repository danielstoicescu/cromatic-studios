+<script>
+// carousels: prev/next buttons
+document.querySelectorAll('[data-rail]').forEach(rail=>{
+  const track=rail.querySelector('.track');
+  const prev=rail.querySelector('[data-prev]');
+  const next=rail.querySelector('[data-next]');
+  if(!track||!prev||!next) return;
+  const step=()=>{const item=track.firstElementChild;const gap=parseFloat(getComputedStyle(track).columnGap)||0;return item?item.getBoundingClientRect().width+gap:track.clientWidth};
+  const update=()=>{
+    const max=track.scrollWidth-track.clientWidth-2;
+    prev.disabled=track.scrollLeft<=2;
+    next.disabled=track.scrollLeft>=max;
+    rail.querySelector('.rail-btns').style.visibility=max<=0?'hidden':'visible';
+  };
+  let down=false,startX=0,startLeft=0,moved=false,target=0,raf=0;
+  const follow=()=>{raf=0;track.scrollLeft=target;};
+  track.addEventListener('pointerdown',e=>{
+    if(e.pointerType!=='mouse'||e.button!==0||track.scrollWidth<=track.clientWidth+2)return;
+    down=true;moved=false;startX=e.clientX;startLeft=track.scrollLeft;target=startLeft;
+    track.classList.add('is-dragging');
+    track.setPointerCapture(e.pointerId);
+  });
+  track.addEventListener('pointermove',e=>{
+    if(!down)return;
+    e.preventDefault();
+    const dx=e.clientX-startX;
+    if(Math.abs(dx)>3)moved=true;
+    target=startLeft-dx;
+    if(!raf)raf=requestAnimationFrame(follow);
+  });
+  const endDrag=e=>{
+    if(!down)return;
+    down=false;
+    if(raf){cancelAnimationFrame(raf);raf=0;track.scrollLeft=target;}
+    try{track.releasePointerCapture(e.pointerId)}catch(err){}
+    const x=track.scrollLeft;
+    track.classList.remove('is-dragging');
+    track.scrollLeft=x;
+  };
+  track.addEventListener('pointerup',endDrag);
+  track.addEventListener('pointercancel',endDrag);
+  track.addEventListener('dragstart',e=>e.preventDefault());
+  track.addEventListener('click',e=>{if(moved){e.preventDefault();e.stopPropagation();moved=false;}},true);
+  prev.addEventListener('click',()=>track.scrollBy({left:-step(),behavior:'smooth'}));
+  next.addEventListener('click',()=>track.scrollBy({left:step(),behavior:'smooth'}));
+  // r137c: as on the other case pages, a vertical wheel or trackpad gesture over a rail scrolls it sideways until it
+  // reaches an end (then the page scrolls on); the arrow keys step it when it has focus
+  track._wheel=1;
+  track.addEventListener('wheel',e=>{
+    if(e.ctrlKey||Math.abs(e.deltaX)>=Math.abs(e.deltaY))return;
+    const max=track.scrollWidth-track.clientWidth;
+    if(max<=1)return;
+    const d=e.deltaY*(e.deltaMode===1?16:e.deltaMode===2?track.clientWidth:1);
+    if((d>0&&track.scrollLeft>=max-1)||(d<0&&track.scrollLeft<=1))return;
+    e.preventDefault();
+    track.style.scrollSnapType='none';clearTimeout(track._ws);track._ws=setTimeout(()=>{track.style.scrollSnapType=''},220);
+    track.scrollLeft=Math.max(0,Math.min(max,track.scrollLeft+d));
+  },{passive:false});
+  track.addEventListener('keydown',e=>{
+    if(e.key!=='ArrowRight'&&e.key!=='ArrowLeft')return;
+    e.preventDefault();
+    track.scrollBy({left:(e.key==='ArrowRight'?1:-1)*step(),behavior:'smooth'});
+  });
+  track.addEventListener('scroll',update,{passive:true});
+  addEventListener('resize',update);
+  addEventListener('load',update);
+  update();
+});
+
+// videos: use the file's real ratio (no cropping), play only when visible, respect reduced motion
+const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
+const vids=document.querySelectorAll('video:not([data-manual])');
+vids.forEach(v=>{
+  const fit=()=>{if(v.videoWidth&&v.videoHeight){const fig=v.closest('figure');if(fig&&!fig.hasAttribute('data-fixed-ratio'))fig.style.setProperty('--r',(v.videoWidth/v.videoHeight).toFixed(4));}};
+  if(v.readyState>=1)fit();else v.addEventListener('loadedmetadata',fit,{once:true});
+});
+if(reduce){
+  vids.forEach(v=>{v.removeAttribute('autoplay');v.pause();v.controls=true;});
+}else if('IntersectionObserver' in window){
+  const io=new IntersectionObserver(entries=>entries.forEach(e=>{
+    if(e.isIntersecting){e.target.play().catch(()=>{});}else{e.target.pause();}
+  }),{threshold:.15});
+  vids.forEach(v=>io.observe(v));
+}
+
+// website mockups: scale the live site to the device width
+const screens=document.querySelectorAll('[data-screen]');
+const scale=s=>{
+  const f=s.querySelector('iframe');
+  const k=s.clientWidth/Number(s.dataset.screen);
+  if(!k) return;
+  f.style.width=s.dataset.screen+'px';
+  f.style.height=Math.ceil(s.clientHeight/k)+'px';
+  f.style.transform=`scale(${k})`;
+};
+if('ResizeObserver' in window){const ro=new ResizeObserver(es=>es.forEach(e=>scale(e.target)));screens.forEach(s=>ro.observe(s));}
+else{screens.forEach(scale);addEventListener('resize',()=>screens.forEach(scale));}
+
+// pillar titles: the two pills drop in once, when the chapter first shows
+if(!matchMedia('(prefers-reduced-motion: reduce)').matches){
+  const titles=[...document.querySelectorAll('.chapter-side .pill-title')];
+  titles.forEach(t=>t.classList.add('drop-ready'));
+  const dropIo=new IntersectionObserver(es=>es.forEach(e=>{
+    if(e.isIntersecting){e.target.classList.add('is-dropped');dropIo.unobserve(e.target);}
+  }),{threshold:.6});
+  titles.forEach(t=>dropIo.observe(t));
+}
+
+// quote: reveal one line at a time
+document.querySelectorAll('[data-lines]').forEach(el=>{
+  const text=el.textContent.trim();
+  const build=()=>{
+    el.innerHTML=text.split(/\s+/).map(w=>`<span class="w">${w}</span>`).join(' ');
+    const words=[...el.querySelectorAll('.w')];
+    const lines=[];let top=null;
+    words.forEach(w=>{const t=Math.round(w.offsetTop);if(top===null||t!==top){lines.push([]);top=t;}lines[lines.length-1].push(w.textContent);});
+    el.innerHTML=lines.map((l,i)=>`<span class="line" style="--i:${i}"><span>${l.join(' ')}</span></span>`).join('');
+    const holder=el.closest('blockquote')||el;
+    holder.style.setProperty('--lines',lines.length);
+  };
+  build();
+  // r137c: the lines are measured again once the web font is in (measured on the fallback they broke one word early)
+  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(build);
+  let t;addEventListener('resize',()=>{clearTimeout(t);t=setTimeout(()=>{(el.closest('blockquote')||el).classList.remove('is-in');build();io2.observe(el);},200);});
+});
+const io2=new IntersectionObserver(es=>es.forEach(e=>{
+  if(e.isIntersecting){(e.target.closest('blockquote')||e.target).classList.add('is-in');io2.unobserve(e.target);}
+}),{threshold:.4});
+document.querySelectorAll('[data-lines]').forEach(el=>io2.observe(el));
+
+// r137c: "Ne știm de la Steam": the lines rise in once (r138d: at a set size, no longer fitted to the width)
+(function(){
+  const big=document.querySelector('.steam-big');
+  if(!big)return;
+  if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&'IntersectionObserver' in window){
+    big.classList.add('sb-ready');
+    const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){big.classList.add('sb-in');io.disconnect();}}),{threshold:.35});
+    io.observe(big);
+  }
+})();
+
+// r138h: Steam's first year: the frame holds still while the page scrolls past it, the photo starts close on the logo
+// stencilled on the wall and zooms out and down to the founders on the floor (transform only, one frame per scroll)
+(function(){
+  const box=document.querySelector('.steam-wall'),fr=box&&box.querySelector('.sw-frame'),img=fr&&fr.querySelector('img');
+  if(!img||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
+  const NW=1400,NH=1076,LX=735,LY=235; // the photo's size and the logo's centre in it
+  box.classList.add('sw-live');
+  let W=0,H=0,b=1,s0=1,top=0,raf=0,tall=false;
+  const clamp=(v,a,z)=>Math.min(z,Math.max(a,v));
+  const ease=t=>t<.5?2*t*t:1-Math.pow(-2*t+2,2)/2;
+  const size=()=>{W=fr.clientWidth;H=fr.clientHeight;b=Math.max(W/NW,H/NH);tall=W/H<.8;s0=Math.max(1.25,H/(b*(tall?560:500)));top=parseFloat(getComputedStyle(fr).top)||0;img.style.width=NW*b+'px';img.style.height=NH*b+'px';};
+  const draw=()=>{
+    raf=0;
+    const r=box.getBoundingClientRect();
+    if(r.bottom<-50||r.top>innerHeight+50)return;
+    const p=clamp((top-r.top)/Math.max(1,r.height-H),0,1),e=ease(clamp((p-.06)/.8,0,1));
+    const vEnd=NH-H/(2*b);let s,u,v;
+    if(tall){
+      // r139i (Daniel: "too dramatic, left to right"): a phone stays centred on the founder in the middle, down from the logo, the two beside him half in frame
+      s=Math.pow(s0,1-e);u=LX+(722-LX)*e;v=LY+(vEnd-LY)*e;
+    }else{s=Math.pow(s0,1-e);u=LX+(NW/2-LX)*e;v=LY+(vEnd-LY)*e;}
+    const tx=clamp(W/2-u*b*s,W-NW*b*s,0),ty=clamp(H/2-v*b*s,H-NH*b*s,0);
+    img.style.transform='translate3d('+tx.toFixed(1)+'px,'+ty.toFixed(1)+'px,0) scale('+s.toFixed(4)+')';
+    fr.style.setProperty('--sw-cap',clamp((e-.72)/.25,0,1).toFixed(3));
+  };
+  const req=()=>{if(!raf)raf=requestAnimationFrame(draw);};
+  size();draw();
+  addEventListener('scroll',req,{passive:true});
+  addEventListener('resize',()=>{size();draw();});
+  if('ResizeObserver' in window)new ResizeObserver(()=>{size();draw();}).observe(fr);
+})();
+
+// mobile: sections that end with text get double bottom padding
+const small=matchMedia('(max-width: 640px)');
+const tablet=matchMedia('(min-width: 641px) and (max-width: 1024px)');
+const TEXT=new Set(['P','FIGCAPTION','LI','CITE','BLOCKQUOTE','H1','H2','H3','H4','SPAN']);
+const isHidden=el=>getComputedStyle(el).display==='none';
+const lastVisible=el=>{let c=el.lastElementChild;while(c&&isHidden(c))c=c.previousElementSibling;return c;};
+const endsWithText=box=>{
+  let el=lastVisible(box);
+  while(el&&lastVisible(el)&&!el.matches('.btn,.pill,.frame,.to-result,.solution-intro'))el=lastVisible(el);
+  return !!el&&TEXT.has(el.tagName)&&!el.closest('.btn,.pill,.frame,.to-result,.solution-intro');
+};
+const pads=[...document.querySelectorAll('.card')].map(c=>c.lastElementChild).filter(Boolean);
+const applyPad=()=>pads.forEach(b=>{
+  b.style.paddingBottom='';
+  if(!endsWithText(b))return;
+  const pb=parseFloat(getComputedStyle(b).paddingBottom);
+  if(small.matches)b.style.paddingBottom=(pb*2)+'px';
+  else if(tablet.matches)b.style.paddingBottom=(pb+45)+'px';
+});
+small.addEventListener('change',applyPad);
+tablet.addEventListener('change',applyPad);
+addEventListener('load',applyPad);
+applyPad();
+
+// hero parallax: the first image drifts a little slower than the page
+(function(){
+  if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;
+  const media=[...document.querySelectorAll('.hero-media .frame>img,.hero-media .frame>video')];
+  if(!media.length)return;
+  let raf=0;
+  const run=()=>{raf=0;media.forEach(m=>{const f=m.parentElement.getBoundingClientRect();if(f.bottom<0||f.top>innerHeight)return;const k=(f.top+f.height/2-innerHeight/2)/innerHeight;m.style.setProperty('--py',(Math.max(-1,Math.min(1,k))*-f.height*.035).toFixed(1)+'px')})};
+  addEventListener('scroll',()=>{if(!raf)raf=requestAnimationFrame(run)},{passive:true});
+  addEventListener('resize',run);run();
+})();
+// rails: a vertical wheel or trackpad gesture over a rail scrolls it sideways until it reaches an end
+// (r137c: Steam's own script now does this for its [data-rail] tracks and marks them _wheel; not twice)
+document.querySelectorAll('.track').forEach(t=>{
+  if(t._wheel)return;
+  t.addEventListener('wheel',e=>{
+    if(e.ctrlKey||Math.abs(e.deltaX)>=Math.abs(e.deltaY))return;
+    const max=t.scrollWidth-t.clientWidth;
+    if(max<=1)return;
+    const d=e.deltaY*(e.deltaMode===1?16:e.deltaMode===2?t.clientWidth:1);
+    if((d>0&&t.scrollLeft>=max-1)||(d<0&&t.scrollLeft<=1))return;
+    e.preventDefault();
+    t.style.scrollSnapType='none';clearTimeout(t._ws);t._ws=setTimeout(()=>{t.style.scrollSnapType=''},220);
+    t.scrollLeft=Math.max(0,Math.min(max,t.scrollLeft+d));
+  },{passive:false});
+});
+// embedded in the drive: keep links between case studies inside the frame
+if(document.documentElement.classList.contains('embed'))document.querySelectorAll('a[href^="/work/"]').forEach(a=>{a.href=a.getAttribute('href')+'?embed=1'});
+</script>
+</body>
