+  <div class="wrap">
+    <span class="eyebrow rv"><svg class="star" style="width:12px;height:12px"><use href="#st"/></svg> Cromatic Studios · Longevity naming · Addendum · October 2026</span>
+    <h1 class="mega hero__name rv" data-d="1" style="margin-top:1.2rem" aria-label="age8">age<span class="eight"><i id="eight">8</i></span></h1>
+    <p class="hero__read rv" data-d="2">Written with an eight. Read as <span class="swap"><span>a number.</span><span><b>infinity.</b></span></span></p>
+    <div class="chips rv" data-d="3" style="margin-top:1.4rem">
+      <span class="chip chip--ink"><svg class="ico"><use href="#i-eight"/></svg> Four characters</span>
+      <span class="chip"><svg class="ico"><use href="#i-inf"/></svg> The logo is inside the name</span>
+      <span class="chip chip--g"><svg class="ico"><use href="#i-check"/></svg> Register looks open</span>
