+/* ---- case pages built on the Steam system: brand accent, embed mode, extras ---- */
+:root{--accent:#F39A3D;--accent-fg:#2b1606;--accent-ink:#b8560a;--frame-bg:#d9d9d9}
+.solution-intro{background:var(--accent);color:var(--accent-fg)}
