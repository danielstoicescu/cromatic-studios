+.mm-sn::after { content: ""; width: 9px; height: 9px; background: var(--sc); flex: none; }
+.mm-sc { margin-left: auto; color: var(--muted); font-size: 10.5px; }
+.mm-ul { list-style: none; margin: 0; padding: 0; }
+.mm-row .mm-ul { display: flex; flex-wrap: wrap; gap: 0 36px; }
+.mm-i { position: relative; display: flex; align-items: center; gap: 12px; padding: 5px 0 5px 0; text-decoration: none; color: var(--ink); border-radius: 0; transition: color .12s, padding .15s var(--eoq); }
+.mm-i::before { content: ""; position: absolute; left: 0; top: 50%; width: 12px; height: 3px; margin-top: -1.5px; background: var(--sc); transform: scaleX(0); transform-origin: 0 50%; transition: transform .15s var(--eoq); }
