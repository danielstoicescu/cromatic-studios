+          <article class="proj">
+            <figure style="--r:1.778" data-fixed-ratio><div class="frame"><img src="m:lacalut/lg-launcher" alt="" width="1200" height="1000" loading="lazy" decoding="async"></div></figure>
+            <h3>Lacalut</h3>
+            <p>Lacalut White & Repair on LG Smart TV home screens: three still formats and a 15-second banner in motion.</p>
+            <ul class="pills"><li><span class="pill pill--marketing">Growth &amp; Content</span></li><li><span class="pill pill--video">Photo &amp; Video</span></li></ul>
+            <a class="cover" href="/work/lacalut/" aria-label="Lacalut case study"></a>
+          </article>
+          <article class="proj">
+            <figure style="--r:1.778" data-fixed-ratio><div class="frame"><img src="m:maximag/launcher" alt="" width="1600" height="1333" loading="lazy" decoding="async"></div></figure>
+            <h3>Maximag</h3>
+            <p>Maximag Bisglicinat on LG Smart TV home screens: three still formats and a 15-second banner with a short story in it.</p>
+            <ul class="pills"><li><span class="pill pill--marketing">Growth &amp; Content</span></li><li><span class="pill pill--video">Photo &amp; Video</span></li></ul>
