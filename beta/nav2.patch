+.line{display:block;overflow:hidden;padding-bottom:.22em;margin-bottom:-.22em}
+.line>span{display:block;transform:translateY(110%);opacity:0}
+.is-in .line>span{transform:none;opacity:1;transition:transform var(--line-dur,.85s) cubic-bezier(.2,.75,.2,1),opacity var(--line-dur,.85s) ease;transition-delay:calc(var(--i) * var(--line-step,.09s))}
+.is-in cite{opacity:1;transition-delay:calc(var(--lines,1) * var(--line-step,.09s) + .35s)}
