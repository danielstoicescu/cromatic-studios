+/* r136: the banner to the Craft Coffee case (same team), in place of the old webshop frames */
+.xbanner{display:grid;gap:14px;justify-items:start;padding:clamp(22px,3vw,40px);border:var(--line);border-radius:var(--radius-l);background:var(--blue);color:var(--ink);text-decoration:none;transition:transform .25s cubic-bezier(.2,.8,.2,1),box-shadow .25s}
+.xbanner:hover{transform:translateY(-3px) rotate(-.3deg);box-shadow:0 14px 30px rgba(18,18,18,.14)}
+.xb-t{font-size:var(--fs-h3);line-height:var(--lh-h3);font-weight:900;letter-spacing:-.01em;max-width:16em}
+.xb-p{max-width:30em}
+.xb-go{display:inline-flex;align-items:center;gap:10px;margin-top:6px;padding:10px 26px 13px;border-radius:999px;background:var(--ink);color:var(--white);font-weight:800;font-size:var(--fs-ui);line-height:var(--lh-ui)}
+@media (prefers-reduced-motion:reduce){.xbanner{transition:none}.xbanner:hover{transform:none}}
+/* r137c: the green T-shirt answers the founder's quote early on (it used to sit by the closing quote) */
+.quote--photo{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(24px,4vw,72px);align-items:center;padding:clamp(8px,2vw,32px) 0 0 clamp(0px,5vw,80px)}
+.quote--photo figure{min-width:0}
+/* r138c: the tee photo on its own (the founder quote was not real) */
+.tee-solo{max-width:min(820px,100%);margin:clamp(28px,4vw,72px) auto 0}
+.tee-solo figure{margin:0}
+@media (max-width:640px){.quote--photo{grid-template-columns:minmax(0,1fr);padding:0}}
+/* r137c: "Ne știm de la Steam" closes the story between the last two photos.
+   r138d (Daniel: "written way too big"): a display size, no longer fitted to the width, in a classic high-contrast
+   serif with an italic, like Steam's T-shirts ("Shared sips, endless energy."): DM Serif Display (SIL OFL 1.1),
+   served from our own fonts by the build as 'Steam Serif' (build/build.mjs); Didot/Georgia until it loads */
+.steam-outro{container-type:inline-size;padding:clamp(40px,6vw,104px) 0 clamp(44px,7vw,120px)}
+.steam-big{max-width:none;font-family:'Steam Serif','DM Serif Display',Didot,'Bodoni 72',Georgia,serif;font-size:clamp(46px,7.4cqi,104px);font-weight:400;line-height:1.02;letter-spacing:-.012em;color:var(--yellow);font-synthesis:none}
+.steam-big em{font-style:italic;letter-spacing:0;padding-right:.04em}
+.steam-big .sb-l{display:block;white-space:nowrap}
+.steam-big .sb-l+.sb-l{margin-top:.07em}
+@media (max-width:640px){.steam-big{font-size:clamp(38px,13.5cqi,64px)}}
+.steam-big.sb-ready .sb-l{opacity:0;transform:translateY(.3em)}
+.steam-big.sb-ready.sb-in .sb-l{opacity:1;transform:none;transition:opacity .7s ease,transform .9s cubic-bezier(.2,.75,.2,1)}
+.steam-big.sb-ready.sb-in .sb-l+.sb-l{transition-delay:.14s}
+/* r138h: Steam's first year, right after the hero: the stencilled logo on the wall first, then, as the page scrolls,
+   the founders on the floor below it (a zoom out and a pan, transform only, drawn by the script at the end). Without
+   the script or with reduced motion it is one still frame, cropped to show both */
+.sw-frame{position:relative;margin:0;height:min(calc(100svh - 2 * var(--gutter)),112vw);border:var(--line);border-radius:var(--radius-l);overflow:hidden;background:#cddfd5}
+.sw-frame img{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;object-position:50% 62%}
+.sw-cap{position:absolute;left:clamp(12px,2vw,28px);bottom:clamp(12px,2vw,28px);z-index:1;margin:0;padding:6px 16px 8px;border:var(--line);border-radius:999px;background:var(--white);color:var(--ink);font-size:var(--fs-small);line-height:var(--lh-small);font-weight:800}
+.steam-wall.sw-live{height:calc(100svh + max(90svh,560px))}
+.sw-live .sw-frame{position:sticky;top:max(var(--gutter),calc(50svh - 56vw))}
+.sw-live .sw-frame img{inset:auto;left:0;top:0;object-fit:fill;transform-origin:0 0;will-change:transform}
+.sw-live .sw-cap{opacity:var(--sw-cap,0);transform:translateY(calc((1 - var(--sw-cap,0)) * 10px))}
+/* r138i (Daniel: "on mobile it is still small, it sits in the middle of the page"): on phones the wall fills the
+   screen, edge to edge and the full height, with no bands while it holds; the script pans across the three founders */
+@media (max-width:640px){
+  .sw-frame{margin-inline:calc(-1 * var(--gutter));height:100svh;height:100dvh;border:0;border-radius:0}
+  .steam-wall.sw-live{height:calc(100svh + max(100svh,640px))}
+  .sw-live .sw-frame{top:0}
+  .sw-cap{bottom:max(14px,calc(env(safe-area-inset-bottom) + 10px))}
+}
+/* r138h: the camera with the "Ne știm de la Steam" sticker, next to the line it carries */
+.sb-pair{display:grid;grid-template-columns:minmax(0,max-content) minmax(0,clamp(220px,30%,400px));justify-content:center;gap:clamp(36px,8vw,140px);align-items:center}
+.sb-photo{margin:0;transform:rotate(1.5deg)}
+.sb-photo .frame{max-height:none}
+@media (max-width:640px){.sb-pair{grid-template-columns:minmax(0,1fr);justify-content:normal}.sb-photo{width:min(78%,340px);justify-self:end;margin-top:8px}}
+/* r138h: the Craft Coffee banner carries a picture of the shop's equipment */
+.xb-has-img{grid-template-columns:minmax(0,1fr) minmax(0,clamp(180px,34%,320px));align-items:center;gap:clamp(18px,3vw,40px)}
+.xb-txt{display:grid;gap:14px;justify-items:start}
