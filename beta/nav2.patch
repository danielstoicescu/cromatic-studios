@@ -0,0 +1,882 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<title>Bonilash — Cromatic Studios</title>
+<meta name="description" content="Bonilash: bonilash.ro, the product site for a lash serum and a brow serum in the Zdrovit portfolio, on desktop and phone. By Cromatic Studios, Bucharest.">
+<link rel="canonical" href="%%SITE_URL%%/work/bonilash/">
+<meta property="og:type" content="article">
+<meta property="og:title" content="Bonilash — Cromatic Studios">
+<meta property="og:description" content="Bonilash: bonilash.ro, the product site for a lash serum and a brow serum in the Zdrovit portfolio, on desktop and phone. By Cromatic Studios, Bucharest.">
+<meta property="og:url" content="%%SITE_URL%%/work/bonilash/">
+<meta property="og:image" content="m:bonilash/hero">
+<link rel="icon" href="/favicon.ico" sizes="32x32">
+<script>(function(){try{if(/[?&]embed\b/.test(location.search)||window.self!==window.top)document.documentElement.classList.add("embed")}catch(e){document.documentElement.classList.add("embed")}})();</script>
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link href="https://fonts.googleapis.com/css2?family=Darker+Grotesque:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
+<style>
+:root{
+  --ink:#121212;
+  --paper:#F1F1F1;
+  --white:#FFFFFF;
+  --yellow:#FFD147;
+  --cream:#FFEDB5;
+  --blue:#519EF5;
+  --blue-soft:#DCEBFD;
+  --green:#2ECB42;
+  --green-soft:#D8F5DC;
+  --purple:#B49BE0;
+  --purple-soft:#EAE2F8;
+  --red:#F0544C;
+  --red-soft:#FCDEDC;
+  --orange:#F58D42;
+  --orange-soft:#FCE3CF;
+  --muted:#5a5a5a;
+
+  --radius-l:36px;
+  --radius-m:18px;
+  --line:1px solid var(--ink);
+  --gutter:clamp(10px,1.2vw,16px);
+  --pad:clamp(22px,4vw,64px);
+  --media-pad:var(--gutter);
+  --font:"Darker Grotesque",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
+
+  /* type scale (~1.333), 375px -> 1440px */
+  --fs-display:clamp(3rem,1.591rem + 6.01vw,7rem);
+  --fs-hero:clamp(2.86rem,1.761rem + 4.687vw,5.98rem);
+  --fs-h2:clamp(2.5rem,1.708rem + 3.38vw,4.75rem);
+  --fs-h3:clamp(1.875rem,1.479rem + 1.69vw,3rem);
+  --fs-lead:clamp(1.375rem,1.199rem + .751vw,1.875rem);
+  --fs-body:clamp(1.125rem,1.059rem + .282vw,1.3125rem);
+  --fs-ui:clamp(1.0625rem,1.041rem + .094vw,1.125rem);
+  --fs-small:clamp(.9375rem,.916rem + .094vw,1rem);
+  /* line heights: standard values reduced by 15% */
+  --lh-display:.89;
+  --lh-hero:.9;
+  --lh-h2:.92;
+  --lh-h3:.95;
+  --lh-lead:1.1;
+  --lh-body:1.2;
+  --lh-ui:1.1;
+  --lh-small:1.15;
+  --rail-h:clamp(300px,34vw,520px);
+  --caption-gap:8px;
+  --max-h:min(78svh,760px);
+}
+*,*::before,*::after{box-sizing:border-box}
+html{scroll-behavior:smooth}
+body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);font-size:var(--fs-body);font-weight:600;line-height:var(--lh-body);-webkit-font-smoothing:antialiased}
+img,video,iframe{display:block;max-width:100%}
+a{color:inherit}
+h1,h2,h3,p,figure,ul,blockquote{margin:0}
+h1,h2,h3{font-weight:900;letter-spacing:-.01em}
+:focus-visible{outline:3px solid var(--blue);outline-offset:3px;border-radius:6px}
+.page{padding:var(--gutter);display:grid;grid-template-columns:minmax(0,1fr);gap:var(--gutter)}
+.card{min-width:0;border:var(--line);border-radius:var(--radius-l);overflow:hidden}
+.inner{padding:var(--pad)}
+.prose{max-width:34em}
+.prose p+p{margin-top:.8em}
+.prose strong{font-weight:900}
+
+/* pills */
+.pills{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0}
+.pill{display:inline-block;padding:6px 20px 8px;border:var(--line);border-radius:999px;font-weight:700;font-size:var(--fs-ui);line-height:var(--lh-ui);text-decoration:none;transition:background .2s}
+.pill--brand{background:var(--green)}
+.pill--marketing{background:var(--red)}
+.pill--product{background:var(--purple)}
+.pill--accent{background:var(--yellow)}
+.pill--video{background:var(--orange)}
+a.pill:hover{background:var(--white)}
+
+/* media: every frame keeps the file's own ratio (--r) */
+.frame{position:relative;width:100%;aspect-ratio:var(--r,1.5);max-height:var(--max-h);border-radius:var(--radius-m);overflow:hidden;background:#d9d9d9}
+.frame img,.frame video{width:100%;height:100%;object-fit:cover}
+figcaption{margin-top:var(--caption-gap);font-size:var(--fs-small);font-weight:600;color:var(--muted);line-height:var(--lh-small)}
+.stack{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--gutter)}
+.stack>figcaption{margin-top:calc(var(--caption-gap) - var(--gutter))}
+.chapter-media>figcaption{margin-top:calc(var(--caption-gap) - clamp(28px,3vw,48px))}
+/* justified rows: widths follow each ratio, so heights match with zero cropping */
+.row{display:flex;flex-wrap:wrap;gap:var(--gutter)}
+.row>figure{flex:var(--r) 1 0;min-width:0}
+
+/* carousels: fixed height, width from ratio */
+.rail-head{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:12px}
+.rail-head h4{margin:0;display:flex;flex-wrap:wrap;gap:0;padding-top:5%}
+.rail-head h4 .pill{background:var(--white);font-size:var(--fs-ui);line-height:var(--lh-ui);font-weight:800;position:relative;transform:rotate(var(--rot,-9deg))}
+.rail-head h4 .pill:nth-child(even){margin-left:-14px;z-index:1;transform:rotate(var(--rot,7deg))}
+@media (min-width:1025px){
+  .chapter-media>:first-child .rail-head h4,.chapter-media>.rail-head:first-child h4{padding-top:2%}
+}
+.rail-btns{display:flex;gap:6px}
+.rail-btns button{width:46px;height:46px;border-radius:50%;border:var(--line);background:var(--white);font:inherit;font-size:calc(var(--fs-ui) * 1.63);line-height:1;cursor:pointer;display:grid;place-items:center;padding:0 0 2px}
+.rail-btns button:hover{background:var(--yellow)}
+.rail-btns button:disabled{opacity:.3;cursor:default;background:var(--white)}
+.track{display:flex;gap:var(--gutter);overflow-x:auto;scroll-behavior:auto;scroll-snap-type:x proximity;scrollbar-width:none;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
+.track::-webkit-scrollbar{display:none}
+.track>*{flex:0 0 auto;scroll-snap-align:start}
+.track>figure{width:calc(var(--rail-h) * var(--r))}
+.track>figure .frame{width:100%;height:var(--rail-h);max-height:none}
+.track img{-webkit-user-drag:none;user-select:none}
+.track.is-dragging{scroll-snap-type:none;cursor:grabbing;user-select:none}
+.track.is-dragging *{pointer-events:none}
+@media (hover:hover) and (pointer:fine){.track{cursor:grab}}
+
+/* hero */
+.hero{background:var(--white)}
+.hero-top{display:grid;grid-template-columns:minmax(0,2.2fr) minmax(300px,1fr);gap:clamp(24px,4vw,72px);align-items:start}
+.hero h1{font-size:var(--fs-hero);line-height:var(--lh-hero)}
+.hero-info{display:grid;gap:clamp(18px,2vw,28px);padding-top:15px}
+.hero-title{display:grid;gap:clamp(10px,1vw,16px)}
+.client-row{display:flex;flex-wrap:wrap;align-items:center;gap:12px 18px}
+.client-row .pill{font-weight:800;opacity:0;animation:pill-drop .95s cubic-bezier(.45,0,.9,.5) both}
+.client-row li:nth-child(1) .pill{animation-delay:1.1s}
+.client-row li:nth-child(2) .pill{animation-delay:1.28s}
+.client-row li:nth-child(3) .pill{animation-delay:1.46s}
+@keyframes pill-drop{
+  0%{opacity:0;transform:translateY(-190px)}
+  10%{opacity:1}
+  52%{transform:translateY(0);animation-timing-function:cubic-bezier(.2,.6,.4,1)}
+  70%{transform:translateY(-22px);animation-timing-function:cubic-bezier(.5,0,.9,.5)}
+  85%{transform:translateY(0);animation-timing-function:cubic-bezier(.2,.6,.4,1)}
+  93%{transform:translateY(-7px)}
+  100%{opacity:1;transform:translateY(0)}
+}
+.client-name{font-size:var(--fs-lead);font-weight:900;line-height:var(--lh-lead)}
+.info{list-style:none;padding:0;display:grid;gap:14px}
+.info li:first-child{font-weight:800}
+.hero-media{margin-top:clamp(28px,4vw,56px);animation:hero-in .85s ease-in .2s both}
+@keyframes hero-in{0%{opacity:0;transform:scale(.5)}28%{opacity:1;transform:scale(.5)}100%{opacity:1;transform:scale(1)}}
+.hero-media .frame{border:var(--line);border-radius:24px}
+
+/* section heads */
+.sec-head>.prose{padding-top:15px}
+.sec-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,4vw,72px);align-items:start}
+.sec-head h2{font-size:var(--fs-h2);line-height:var(--lh-h2)}
+
+/* problem */
+.problem{background:var(--white)}
+.problem-media{margin-top:clamp(32px,5vw,72px)}
+.quote{margin-top:clamp(32px,5vw,72px);padding:6.53% 19%;display:block}
+.quote blockquote p{font-size:var(--fs-h3);font-weight:800;line-height:var(--lh-h3);color:var(--blue)}
+.quote cite,.result-quote cite{display:block;margin-top:16px;font-size:var(--fs-small);line-height:var(--lh-small);font-weight:800;color:var(--ink);font-style:normal;opacity:0;transition:opacity .7s ease .1s}
+.line{display:block;overflow:hidden;padding-bottom:.22em;margin-bottom:-.22em}
+.line>span{display:block;transform:translateY(110%);opacity:0}
+.is-in .line>span{transform:none;opacity:1;transition:transform var(--line-dur,.85s) cubic-bezier(.2,.75,.2,1),opacity var(--line-dur,.85s) ease;transition-delay:calc(var(--i) * var(--line-step,.09s))}
+.is-in cite{opacity:1;transition-delay:calc(var(--lines,1) * var(--line-step,.09s) + .35s)}
+
+.handoff{margin-top:clamp(40px,6vw,96px);display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:var(--gutter)}
+.solution-intro{background:var(--blue);border:var(--line);border-radius:var(--radius-m);padding:clamp(24px,3.5vw,56px);display:grid;gap:clamp(18px,2vw,28px);align-content:start}
+.solution-intro h2{font-size:var(--fs-h2);line-height:var(--lh-h2)}
+.solution-intro p{max-width:none}
+.to-result{display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:clamp(24px,3vw,40px);background:var(--ink);color:var(--white);border-radius:var(--radius-m);text-decoration:none;transition:transform .2s}
+.to-result b{font-size:calc(var(--fs-lead) * 1.1);font-weight:900;line-height:var(--lh-lead);color:var(--yellow)}
+.go-icon{font-size:1.63em;line-height:1;display:block;transform:translateY(-.02em)}
+.to-result-go{align-self:flex-start;display:inline-flex;align-items:center;gap:10px;margin-top:24px;padding:11px 24px 12px;border-radius:999px;border:1px solid var(--yellow);background:var(--yellow);color:var(--ink);font-weight:800;font-size:var(--fs-ui);line-height:var(--lh-ui)}
+.to-result:hover .to-result-go{background:var(--white);border-color:var(--white)}
+.to-result .to-result-go:hover,.to-result:hover .to-result-go:hover{background:var(--green);border-color:var(--green)}
+.to-result:hover{transform:translateY(-3px)}
+
+/* chapters */
+.chapter{background:var(--white);display:grid;grid-template-columns:minmax(200px,3.2fr) minmax(0,8.8fr)}
+.chapter-side{padding:clamp(22px,2.6vw,44px);border-right:var(--line)}
+.chapter-side>div{display:grid;gap:clamp(18px,2vw,28px)}
+.pill-title{display:flex;flex-direction:column;align-items:flex-start}
+.pill-title{padding-block:6px}
+.pill-title .pill{font-size:var(--fs-lead);line-height:var(--lh-lead);font-weight:900;-webkit-text-stroke:.7px var(--ink);padding:10px 22px 13px;position:relative;transform:rotate(-2.5deg);transform-origin:left center}
+.pill-title .pill:last-child{margin-left:16px;margin-top:-6px;z-index:1;transform:rotate(1.5deg)}
+/* the two title pills drop into place when the chapter first appears */
+.pill-title.drop-ready .pill{opacity:0}
+.pill-title.is-dropped .pill:first-child{animation:drop-a .95s cubic-bezier(.45,0,.9,.5) both}
+.pill-title.is-dropped .pill:last-child{animation:drop-b .95s cubic-bezier(.45,0,.9,.5) .18s both}
+@keyframes drop-a{
+  0%{opacity:0;transform:translateY(-190px) rotate(0deg)}
+  10%{opacity:1}
+  52%{transform:translateY(0) rotate(-2.5deg);animation-timing-function:cubic-bezier(.2,.6,.4,1)}
+  70%{transform:translateY(-22px) rotate(-1deg);animation-timing-function:cubic-bezier(.5,0,.9,.5)}
+  85%{transform:translateY(0) rotate(-2.5deg);animation-timing-function:cubic-bezier(.2,.6,.4,1)}
+  93%{transform:translateY(-7px) rotate(-2deg)}
+  100%{opacity:1;transform:translateY(0) rotate(-2.5deg)}
+}
+@keyframes drop-b{
+  0%{opacity:0;transform:translateY(-190px) rotate(0deg)}
+  10%{opacity:1}
+  52%{transform:translateY(0) rotate(1.5deg);animation-timing-function:cubic-bezier(.2,.6,.4,1)}
+  70%{transform:translateY(-20px) rotate(3deg);animation-timing-function:cubic-bezier(.5,0,.9,.5)}
+  85%{transform:translateY(0) rotate(1.5deg);animation-timing-function:cubic-bezier(.2,.6,.4,1)}
+  93%{transform:translateY(-6px) rotate(2deg)}
+  100%{opacity:1;transform:translateY(0) rotate(1.5deg)}
+}
+.chapter-text{font-size:var(--fs-body);font-weight:700;line-height:var(--lh-body)}
