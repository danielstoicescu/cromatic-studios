+.mm-btn i { width: 7px; height: 7px; border: solid currentColor; border-width: 0 2px 2px 0; transform: translateY(-2px) rotate(45deg); transition: transform .18s var(--eoq); }
+.mm-btn[aria-expanded="true"] i { transform: translateY(1px) rotate(225deg); }
