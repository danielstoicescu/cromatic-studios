+    if(locked || e.pointerType==="touch") return;
+    var r=glyph.getBoundingClientRect();
+    var cx=r.left+r.width/2, cy=r.top+r.height/2;
+    var d=Math.hypot(e.clientX-cx, e.clientY-cy);
+    var inside = d < Math.max(r.width,r.height)*.62;
+    if(inside){ t=90; setFlip(true); }
+    else{
+      var reach=440;
+      t=Math.max(0,Math.min(74, 90*(1-d/reach) ));
+      setFlip(false);
+    }
+    kick();
+  });
+  hero.addEventListener("pointerleave",function(){ if(!locked){ t=0; setFlip(false); kick(); } });
+})();
+
+/* big tabs */
+(function(){
+  var map={ "tab-age8":"panel-age8", "tab-l8":"panel-l8" };
+  var btns=Object.keys(map).map(function(id){ return document.getElementById(id); });
+  function select(id,push){
+    btns.forEach(function(b){
+      var on=b.id===id;
+      b.setAttribute("aria-selected",String(on));
+      document.getElementById(map[b.id]).hidden=!on;
+    });
+    jb.forEach(function(b){
+      var pn=b.dataset.panel;
+      b.style.display=(pn==="shared"||pn===map[id])?"":"none";
+    });
+    if(push){ try{ history.replaceState(null,"","#"+(id==="tab-l8"?"longevit8":"age8")); }catch(e){} }
+  }
+  btns.forEach(function(b){
+    b.addEventListener("click",function(){
+      select(b.id,true);
+      var y=document.querySelector(".tabbar").getBoundingClientRect().top+window.scrollY-56;
+      window.scrollTo({top:Math.max(0,y),behavior:reduce?"auto":"smooth"});
+    });
+  });
+  var h=(location.hash||"").replace("#","");
+  select(h==="longevit8"?"tab-l8":"tab-age8",false);
+})();
+
+/* longevit8: say it at home */
+(function(){
+  var hero=document.getElementById("l-hero");
+  var btn=document.getElementById("l8Btn");
+  if(!hero||!btn) return;
+  var on=false;
+  btn.addEventListener("click",function(){
+    on=!on;
+    hero.classList.toggle("flip",on);
+    btn.setAttribute("aria-pressed",String(on));
+    btn.childNodes[1].nodeValue = on ? " Say it abroad" : " Say it at home";
+  });
+})();
+})();
+</script>
+</body>
+</html>
