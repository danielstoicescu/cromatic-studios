+.czpf { position: fixed; inset: 0; z-index: 95; pointer-events: none; opacity: 0; overflow: hidden; contain: strict; }
+.czpf > i { position: absolute; left: 0; top: 0; transform-origin: 0 0; will-change: transform; }
