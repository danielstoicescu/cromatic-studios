+(function(){
+  var hero=document.getElementById("s-hero");
+  var glyph=document.getElementById("eight");
+  var btn=document.getElementById("turnBtn");
+  var locked=false;
+  function setFlip(on){
+    hero.classList.toggle("flip",on);
+    btn.setAttribute("aria-pressed",String(on));
+    btn.childNodes[1].nodeValue = on ? " Turn it back" : " Turn the eight";
+  }
+  btn.addEventListener("click",function(){ locked=!locked; setFlip(locked); t=locked?90:0; kick(); });
+  if(reduce){
+    btn.addEventListener("click",function(){ glyph.style.rotate=(locked?"90deg":"0deg"); });
+    return;
+  }
+  var t=0, c=0, raf=null;
+  function loop(){
+    c+=(t-c)*.12;
+    glyph.style.rotate=c.toFixed(2)+"deg";
+    var near = Math.abs(t-c)<.05;
+    if(near && !locked && t!==0 && t!==90){ /* settle */ }
+    raf = Math.abs(t-c)>.05 ? requestAnimationFrame(loop) : null;
+  }
+  function kick(){ if(!raf) raf=requestAnimationFrame(loop); }
+  hero.addEventListener("pointermove",function(e){
+    if(locked || e.pointerType==="touch") return;
+    var r=glyph.getBoundingClientRect();
+    var cx=r.left+r.width/2, cy=r.top+r.height/2;
