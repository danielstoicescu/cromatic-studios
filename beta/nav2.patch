+/* r136: the banner to the Craft Coffee case (same team), in place of the old webshop frames */
+.xbanner{display:grid;gap:14px;justify-items:start;padding:clamp(22px,3vw,40px);border:var(--line);border-radius:var(--radius-l);background:var(--blue);color:var(--ink);text-decoration:none;transition:transform .25s cubic-bezier(.2,.8,.2,1),box-shadow .25s}
