+++ b/site/rapoarte/longevity-names-50c84c5bc5/index.html
@@ -0,0 +1,1033 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<meta name="robots" content="noindex, nofollow, noarchive">
+<meta name="referrer" content="no-referrer">
+<title>Longevity · Two New Names · Cromatic Studios</title>
+<link rel="icon" href="/favicon.ico">
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
+<style>
+/* Layout: the Cromatic "Middleman offer" treatment (light, simplified, in colour). Grid paper ground, white cards,
+   black ink keylines, Lexend for everything that speaks, JetBrains Mono for everything that reads as data.
+   Colour is a code, never decoration: green = open / clear / works, coral = taken / blocked / against,
+   yellow = the one thing to look at (the eight, the active tab, the decision), blue = watch / pending / to read / probably,
+   purple = a variant. Text on any colour is black. */
+:root{
+  --cx-blue:#48A8EF;--cx-yellow:#F8D13B;--cx-green:#4CC462;--cx-coral:#F27261;--cx-purple:#AE76E6;
+  --ink:#000000;--paper:#F2F2F2;--bar:#E7E7E7;--white:#FFFFFF;--line:#DCDCDC;--muted:#5E6168;
+  --fd:'Lexend',system-ui,-apple-system,sans-serif;
+  --fm:'JetBrains Mono',ui-monospace,Menlo,monospace;
+  --st:2.5px solid var(--ink);--st2:2px solid var(--ink);
+  --rx:30px;--rl:22px;--rm:14px;--rp:999px;
+  --gut:clamp(16px,4.5vw,22px);--maxw:1244px;
+  --smooth:cubic-bezier(.2,.8,.3,1);--spring:cubic-bezier(.34,1.56,.64,1);--snap:cubic-bezier(.34,1.56,.44,1);
+  --wm:url("data:image/png;base64,");
+}
+*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
+html{-webkit-text-size-adjust:100%;}
+body{font-family:var(--fd);font-size:16px;line-height:1.55;font-weight:400;color:var(--ink);background-color:var(--paper);
+  background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);
+  background-size:34px 34px;-webkit-font-smoothing:antialiased;}
+img,svg{display:block;max-width:100%;}
+a{color:inherit;}
+::selection{background:var(--cx-yellow);color:var(--ink);}
+button{font:inherit;color:inherit;background:none;border:none;}
+:focus-visible{outline:3px solid var(--ink);outline-offset:3px;}
+.wrap{width:100%;max-width:var(--maxw);margin:0 auto;padding-inline:var(--gut);position:relative;}
+section{padding-block:clamp(48px,7vw,80px);position:relative;}
+.sec--dark{background:var(--ink);color:var(--white);}
+.sec--dark .lead,.sec--dark .body{color:var(--white);opacity:.86;}
+.sec--dark .h1{color:var(--white);}
+
+/* type: the Middleman scale */
+.mega,.h1,.h3{font-family:var(--fd);letter-spacing:-.03em;}
+.mega{font-weight:900;font-size:clamp(2.7rem,13vw,9.2rem);line-height:1;letter-spacing:-.045em;}
+.h1{font-weight:800;font-size:clamp(26px,4.2vw,46px);line-height:1.14;max-width:24ch;}
+.h3{font-weight:800;font-size:20px;line-height:1.15;letter-spacing:-.025em;}
+.lead{font-size:clamp(17px,1.7vw,19px);line-height:1.5;font-weight:500;max-width:62ch;}
+.body{font-size:16px;line-height:1.55;}
+.small{font-size:15px;line-height:1.5;}
+.tiny{font-family:var(--fm);font-size:11px;font-weight:500;letter-spacing:.04em;line-height:1.7;color:var(--muted);max-width:90ch;}
+.eyebrow{display:inline-flex;align-items:center;gap:9px;border:var(--st2);border-radius:var(--rp);background:var(--white);padding:7px 15px;font-family:var(--fm);font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;line-height:1.3;}
+.klabel{font-family:var(--fm);font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);display:flex;align-items:center;gap:7px;line-height:1.3;}
+.klabel .ico{width:14px;height:14px;}
+.kl--ok,.kl--no{display:inline-flex;color:var(--ink);border:var(--st2);border-radius:var(--rp);padding:5px 12px;}
+.kl--ok{background:var(--cx-green);}
+.kl--no{background:var(--cx-coral);}
+strong,b{font-weight:700;}
+em{font-style:italic;font-weight:900;}
+.mono{font-family:var(--fm);}
+.star{width:1em;height:1em;flex:0 0 auto;}
+.ico{width:1em;height:1em;flex:0 0 auto;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
+@keyframes spin{to{transform:rotate(360deg);}}
+
+.rv{opacity:0;transform:translateY(14px);transition:opacity .5s var(--smooth),transform .5s var(--smooth);}
+.rv.in{opacity:1;transform:none;}
+.rv[data-d="1"]{transition-delay:.06s}.rv[data-d="2"]{transition-delay:.12s}
+.rv[data-d="3"]{transition-delay:.18s}.rv[data-d="4"]{transition-delay:.24s}
+@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none;}}
+
+/* the deck strip */
+.topbar{position:sticky;top:0;z-index:120;background:var(--bar);border-bottom:var(--st);}
+.tprog{position:absolute;left:0;bottom:-6.5px;height:4px;width:0;background:var(--ink);z-index:2;pointer-events:none;}
+.topbar__in{max-width:var(--maxw);margin:0 auto;padding:9px var(--gut);min-height:54px;display:flex;align-items:center;gap:8px 16px;flex-wrap:wrap;}
+.logo{display:flex;align-items:center;gap:9px;font-weight:800;font-size:12px;line-height:1;white-space:nowrap;text-decoration:none;}
+.logo__play{font-size:11px;}
+.wm{display:inline-block;height:13px;aspect-ratio:720/66;background:var(--wm) no-repeat left center/contain;flex:0 0 auto;}
+.topbar__sp{flex:1 1 auto;}
+.jump{display:flex;gap:6px;flex-wrap:wrap;}
+.jump button{cursor:pointer;font-family:var(--fm);font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;border:var(--st2);border-radius:var(--rp);padding:5px 11px;line-height:1.2;background:var(--white);transition:background .2s,color .2s;}
+.jump button:hover{background:var(--cx-yellow);}
+.jump button[aria-current="true"]{background:var(--ink);color:var(--white);}
+@media(max-width:760px){.jump{display:none;}}
+
+/* chips */
+.chips{display:flex;flex-wrap:wrap;gap:8px;}
+.chip{display:inline-flex;align-items:center;gap:7px;border:var(--st2);border-radius:var(--rp);padding:6px 13px;background:var(--white);font-family:var(--fm);font-size:10.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;line-height:1.25;}
+.chip .ico{width:13px;height:13px;}
+.chip--ink{background:var(--ink);color:var(--white);}
+.chip--g{background:var(--cx-green);}
+.chip--c{background:var(--cx-coral);}
+.chip--y{background:var(--cx-yellow);}
+.chip--p{background:var(--cx-purple);}
+.sec--dark .chip{background:var(--white);color:var(--ink);}
+
+/* cards */
+.card{border:var(--st);border-radius:var(--rx);background:var(--white);padding:26px 28px;}
+.card--ink{background:var(--ink);color:var(--white);}
+.card--ink .body{opacity:.88;}
+.card--ink strong{color:var(--cx-yellow);}
+.card--ink .klabel{color:var(--cx-yellow);}
+.card--mari{background:var(--cx-yellow);}
+.card--mari .klabel{color:var(--ink);}
+.grid{display:grid;gap:18px;}
+@media(min-width:900px){.g2{grid-template-columns:repeat(2,1fr);}.g3{grid-template-columns:repeat(3,1fr);}.g4{grid-template-columns:repeat(4,1fr);}}
+.slist{list-style:none;margin-top:14px;}
+.slist li{display:flex;gap:12px;align-items:flex-start;font-size:15.5px;line-height:1.5;padding:12px 0;border-top:2px solid var(--line);}
+.slist li:last-child{padding-bottom:0;}
+.slist .ico{width:15px;height:15px;margin-top:4px;stroke-width:2.6;}
+.slist b{font-weight:700;}
+
+/* stat tiles */
+.tc{border:var(--st);border-radius:var(--rl);padding:16px 20px 18px;background:var(--white);color:var(--ink);transition:transform .28s var(--spring);}
+.tc:hover{transform:translateY(-3px);}
+.tc b{font-family:var(--fd);font-weight:800;font-size:21px;letter-spacing:-.025em;display:block;line-height:1.1;}
+.tc i{font-style:normal;font-family:var(--fm);font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;display:flex;align-items:center;gap:6px;margin-bottom:8px;opacity:.72;line-height:1.35;}
+.tc i .ico{width:12px;height:12px;}
+.tc span{font-size:14.5px;display:block;margin-top:8px;line-height:1.45;}
+.tc span em{font-style:normal;font-weight:800;}
+.tc b span{font:inherit;display:inline;margin:0;color:inherit;}
+.tc--r{background:var(--cx-coral);}.tc--g{background:var(--cx-green);}.tc--m{background:var(--cx-yellow);}.tc--b{background:var(--cx-blue);}
+.clr-stats{display:grid;gap:14px;margin-top:22px;}
+@media(min-width:820px){.clr-stats{grid-template-columns:repeat(3,1fr);}}
+.clr-stats .tc b{font-weight:900;font-size:clamp(2rem,4vw,2.8rem);letter-spacing:-.035em;line-height:1;}
+
+/* the two big tabs */
+.tabbar{display:grid;grid-template-columns:1fr 1fr;gap:12px;max-width:var(--maxw);margin:0 auto;padding:22px var(--gut) 0;}
+.bigtab{cursor:pointer;text-align:left;padding:clamp(14px,3vw,28px) clamp(14px,3vw,30px);border:var(--st);border-radius:var(--rx);background:var(--white);display:flex;flex-direction:column;gap:8px;min-width:0;transition:background .2s var(--smooth),transform .28s var(--spring);}
+.bigtab__n{font-family:var(--fd);font-weight:900;font-size:clamp(1.3rem,5.4vw,3.7rem);line-height:1;letter-spacing:-.04em;}
+.bigtab__s{font-family:var(--fm);font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;display:inline-flex;align-items:center;gap:6px;line-height:1.35;opacity:.7;}
+.bigtab__s .ico{width:13px;height:13px;}
+.bigtab[aria-selected="true"]{background:var(--cx-yellow);}
+.bigtab[aria-selected="true"] .bigtab__s{opacity:1;}
+.bigtab:hover:not([aria-selected="true"]){background:var(--bar);transform:translateY(-2px);}
+.panel[hidden]{display:none;}
+
+/* HERO */
+.hero{padding-block:clamp(36px,5vw,64px) clamp(48px,7vw,80px);overflow:hidden;}
+.hero__name{display:flex;align-items:baseline;flex-wrap:nowrap;user-select:none;}
+.eight,.o8 span{background:var(--cx-yellow);border:clamp(2.5px,.4vw,4px) solid var(--ink);border-radius:var(--rp);padding:0 .1em .02em;line-height:1;}
+.eight{display:inline-block;position:relative;margin-left:.05em;}
+/* longevit8 glyph swap: two pills in one cell, the 8 flips over into "ate" */
+.o8{display:inline-grid;justify-items:start;perspective:700px;margin-left:.05em;line-height:1;}
+.o8 span{grid-area:1/1;transition:opacity .35s var(--smooth),transform .5s var(--spring);backface-visibility:hidden;-webkit-backface-visibility:hidden;}
+.o8__a{opacity:0;transform:rotateX(-86deg);}
+.hero.flip .o8__d{opacity:0;transform:rotateX(86deg);}
+.hero.flip .o8__a{opacity:1;transform:none;}
+@media (prefers-reduced-motion:reduce){.o8 span{transition:opacity .2s;transform:none !important;}}
+.eight i{display:inline-block;font-style:normal;rotate:var(--er,0deg);transform-origin:50% 55%;will-change:rotate;color:var(--ink);padding:0 .02em;}
+.hero__read{margin-top:22px;font-weight:600;font-style:italic;font-size:clamp(1.2rem,2.6vw,1.9rem);line-height:1.25;letter-spacing:-.02em;min-height:1.3em;}
+.hero__read b{font-weight:900;}
+.hero__read .swap{display:inline-grid;vertical-align:baseline;}
+.hero__read .swap span{grid-area:1/1;transition:opacity .35s var(--smooth),translate .4s var(--spring);}
+.hero__read .swap span:last-child{opacity:0;translate:0 8px;}
+.hero__read .swap span:last-child b{font-style:normal;background:var(--cx-yellow);border:var(--st2);border-radius:var(--rp);padding:0 .32em .04em;}
+.hero.flip .swap span:first-child{opacity:0;translate:0 -8px;}
+.hero.flip .swap span:last-child{opacity:1;translate:0;}
+.turnbtn{display:inline-flex;align-items:center;gap:10px;cursor:pointer;font-family:var(--fd);font-weight:800;font-size:18px;letter-spacing:-.01em;border:var(--st);border-radius:var(--rp);padding:14px 28px;background:var(--cx-yellow);color:var(--ink);transition:background .25s,color .25s,transform .28s var(--spring);}
+.turnbtn:hover{transform:scale(1.04);background:var(--ink);color:var(--white);}
+.turnbtn[aria-pressed="true"]{background:var(--ink);color:var(--white);}
+.turnbtn .ico{width:18px;height:18px;transition:rotate .6s var(--snap);}
+.hero.flip .turnbtn .ico{rotate:90deg;}
+.hero__deco{position:absolute;right:-70px;top:-70px;width:clamp(160px,22vw,300px);color:var(--white);pointer-events:none;z-index:0;}
+.hero__deco svg{animation:spin 54s linear infinite;stroke:var(--ink);stroke-width:.45;stroke-linejoin:round;overflow:visible;}
+.hero .wrap{z-index:1;}
+@media(max-width:560px){.hero__deco{display:none;}.bigtab__s{letter-spacing:.08em;}}
+@media (prefers-reduced-motion:reduce){.eight i{rotate:0deg !important;}.hero.flip .eight i{rotate:90deg !important;transition:none;}.hero__deco svg{animation:none;}}
+
+/* meaning cards */
+.means{display:grid;gap:18px;margin-top:26px;}
+@media(min-width:820px){.means{grid-template-columns:repeat(3,1fr);}}
+.mean{border:var(--st);border-radius:var(--rx);padding:24px 26px;background:var(--white);display:flex;flex-direction:column;gap:14px;transition:transform .28s var(--spring);}
+.mean:hover{transform:translateY(-4px);}
+.mean__top{display:flex;align-items:center;gap:14px;}
+.mean__n{width:46px;height:46px;border:var(--st2);border-radius:var(--rm);background:var(--bar);display:grid;place-items:center;flex:0 0 auto;}
+.mean__n .ico{width:22px;height:22px;color:var(--ink);}
+.mean__k{font-family:var(--fm);font-size:10px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);display:block;}
+.mean b{font-weight:800;font-size:23px;line-height:1.1;letter-spacing:-.025em;display:block;}
+.mean span.t{font-size:15px;display:block;line-height:1.5;padding-top:14px;border-top:2px solid var(--line);}
+
+/* ledger */
+.clx{border:var(--st);border-radius:var(--rx);overflow:hidden;margin-top:18px;background:var(--white);}
+.clx__head{display:flex;align-items:center;gap:10px 14px;flex-wrap:wrap;padding:18px 26px;border-bottom:var(--st);background:var(--bar);}
+.clx__term{font-weight:800;font-size:clamp(1.45rem,2.6vw,2rem);line-height:1;letter-spacing:-.03em;}
+.clx__meta{font-family:var(--fm);font-size:10.5px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);}
+.clx__verdict{margin-left:auto;font-family:var(--fm);font-size:10.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;border:var(--st2);border-radius:var(--rp);padding:5px 13px;flex:0 0 auto;}
+.v--ok{background:var(--cx-green);}
+.v--care{background:var(--cx-yellow);}
+.v--block{background:var(--cx-coral);}
+.hit{display:grid;gap:6px 16px;padding:15px 26px 15px 30px;border-bottom:2px solid var(--line);position:relative;transition:background .2s var(--smooth);}
