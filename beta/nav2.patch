+.steam-outro{container-type:inline-size;padding:clamp(40px,6vw,104px) 0 clamp(44px,7vw,120px)}
+.steam-big{max-width:none;font-family:'Steam Serif','DM Serif Display',Didot,'Bodoni 72',Georgia,serif;font-size:clamp(46px,7.4cqi,104px);font-weight:400;line-height:1.02;letter-spacing:-.012em;color:var(--yellow);font-synthesis:none}
+.steam-big em{font-style:italic;letter-spacing:0;padding-right:.04em}
