diff --git a/site/mods.css b/site/mods.css
new file mode 100644
index 0000000..b6e9de5
--- /dev/null
+++ b/site/mods.css
@@ -0,0 +1,267 @@
+/* r455 · mods (worlds) for the normal site. One for now: html.m-sky, the constellation mod.
+   Own block, appended after the site's stylesheet: nothing here applies unless the class is on <html>
+   (set before the first paint by the one-line script in the head; canvases come from mods.js). */
+.mk { display: none; position: absolute; left: 0; top: 0; z-index: -1; pointer-events: none; }
+.mod-sw { display: inline-flex; align-items: center; gap: 9px; width: fit-content; margin: 6px 0 0; padding: 4px 0; border: 0; background: none; color: inherit; font: inherit; cursor: pointer; text-align: left; }
+.mod-sw::before { content: ""; width: 9px; height: 9px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px currentColor; }
+.mod-sw[aria-pressed="true"]::before { background: currentColor; }
+.mod-sw:hover span { text-decoration: underline; text-decoration-color: var(--y); text-decoration-thickness: 3px; }
+.mod-sw:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
+
+html.m-sky {
+  --m-field: #0d0c09; --m-dot: #fbfaf5; --m-dim: #8c8496; --m-acc: #FED012;
+  --ink: #fbfaf5; --paper: #0d0c09; --alt: #0d0c09; --muted: #a9a399;
+  --f: "Poppins", "PoppinsFB", "CromaticSans", system-ui, sans-serif;
+  color-scheme: dark; background: var(--m-sky, none), var(--m-field);
+}
+html.m-sky .mk { display: block; }
+html.m-sky body { background: transparent; color: var(--ink); font-size: 15.5px; line-height: 1.5; }
+html.m-sky :is(.sec, .sec-alt, .sec-ink, .ftr, .pwall, .hero, .hero-city) { background: transparent; }
+html.m-sky ::selection { background: var(--m-acc); color: #0d0c09; }
+
+/* header */
+html.m-sky .hdr { background: color-mix(in srgb, #0d0c09 84%, transparent); border-bottom-color: rgba(251,250,245,.12); }
+html.m-sky :is(.brand img, .ftr-logo) { filter: invert(1) hue-rotate(180deg); }
+html.m-sky .nav :is(a, button, button span) { font-weight: 400; }
+html.m-sky .lang-sw { background: transparent; border-color: rgba(251,250,245,.5); border-radius: 0; color: var(--ink); font: 700 11px/1 var(--mono); letter-spacing: .12em; }
+html.m-sky .menu-btn { border: 1px solid rgba(251,250,245,.5); border-radius: 0; background: transparent; box-shadow: none; }
+html.m-sky .menu-btn span { height: 1px; border-radius: 0; background: var(--ink); }
+
+/* buttons: a hairline box and mono capitals, the one that matters filled */
+html.m-sky :is(.btn, .sv5-go, .sv5-start, .sh-more) { border: 1px solid rgba(251,250,245,.6); border-radius: 0; background: transparent; color: var(--ink); box-shadow: none; font: 700 12px/1.2 var(--mono); letter-spacing: .12em; text-transform: uppercase; }
+html.m-sky :is(.btn-y, .sv5-go) { border-color: var(--m-acc); background: var(--m-acc); color: #0d0c09; }
+html.m-sky :is(.btn, .sv5-go, .sv5-start, .sh-more):hover { box-shadow: none; border-color: var(--ink); translate: none; }
+html.m-sky .btn.dk-host { background: transparent !important; color: var(--ink) !important; box-shadow: none; border-color: var(--m-acc); }
+html.m-sky .mono { font-size: 11px; }
+
+/* the sky's own stars stay out of the words: every block of type sits on a plate of plain field, 4 px wider than
+   its box (a stray point beside a letter reads as a wrong accent) */
+html.m-sky :is(.pw-h, .pw-offer, .sv5-h, .sv5-lead, .ptitle, .sec-lead, .sh-lead, .sh-sub, .ss-name, main .eyebrow, .friends, .cr-role, .cr-bio, .sv5-card h3 button, .sv5-when, .sv5-body p, .qa summary, .qa details p, .c-txt h2, .c-txt p, .ftr p, .ftr address, .ftr-motto) { background: var(--m-field); box-shadow: 0 0 0 4px var(--m-field); }
+html.m-sky :is(.pw-h, .pw-offer, .sv5-h, .sv5-lead, .ptitle, .sec-lead, .sh-lead, main .eyebrow, .c-txt h2) { width: fit-content; }
+
+/* fold 1 · the heart */
+html.m-sky .pwall.pw-first .pw-gl { display: none; }
+html.m-sky .pw-first .f5-wall { isolation: isolate; }
+html.m-sky .f5 .pw-h { color: var(--ink); font-weight: 400; letter-spacing: -.03em; line-height: 1.08; text-shadow: none; }
+html.m-sky .pw-h.si, html.m-sky .pw-h.si .pw-heart { animation: none; }
+html.m-sky .pw-h.si::after, html.m-sky .pw-h.si .si-w::before, html.m-sky .pw-h.si .si-w::after { content: none; }
+/* the word the heart stands for: heavy and plain white until the heart is lit, then yellow, and only then it glows */
+/* bold from the first paint (the site splits the words inline, before any script of ours): no late reflow */
+html.m-sky .pw-h :is(.mk-em, .si-w[data-t^="experien" i]) { font-weight: 700; text-shadow: none; }
+html.m-sky.mk-heart .pw-h .mk-em { color: var(--m-acc); text-shadow: 0 0 .3em rgba(254,208,18,.42); }
+html.m-sky .pw-offer { color: var(--muted); }
+html.m-sky :is(.pw-cta, .drive-btn, .drive-mini, .hero-city, .drive-cta, .pw-first .pw-rows, a[href^="/city/"]) { display: none !important; }
+html.m-sky .pwall.pw-first.f5c { align-content: stretch; }
+html.m-sky .pw-first .f5-wall { align-self: stretch; justify-self: stretch; width: auto; min-height: 300px; margin-top: 0; }
+@media (min-width: 901px) {
+  /* the headline starts under the logo; the column is wide enough for the longest first line */
+  html.m-sky .pwall.pw-first.f5c { grid-template-columns: minmax(280px, min(620px, 44vw)) minmax(0, 1fr); padding-left: max(48px, calc((100vw - 1200px) / 2)); /* the offer's two lines are held before it is parsed: a paint in between does not move the headline */ grid-template-rows: 1fr auto minmax(72px, auto) 1fr; }
+}
+@media (max-width: 900px) {
+  html.m-sky .pwall.pw-first.f5c { grid-template-areas: "h" "s" "w"; grid-template-rows: auto auto minmax(300px, 1fr); min-height: calc(100svh - 64px); padding-bottom: 0; justify-items: stretch; text-align: left; }
+  html.m-sky .pwall.f5c .pw-h { text-align: left; text-wrap: wrap; }
+  html.m-sky .f5c .pw-offer { margin-inline: 0; }
+  html.m-sky .pw-first .f5-say { margin-top: 10px; }
+}
+.mk-stars, .mk-say { display: none; }
+html.m-sky .mk-stars { display: block; position: absolute; inset: 0; z-index: 2; pointer-events: none; }
+/* a star takes a horizontal drag for itself and leaves the vertical one to the page */
+html.m-sky .mk-star { position: absolute; width: 48px; height: 48px; margin: -24px 0 0 -24px; padding: 0; border: 0; border-radius: 0; background: none; color: inherit; cursor: pointer; pointer-events: auto; touch-action: pan-y; -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; }
+html.m-sky .mk-star:focus { outline: none; }
+html.m-sky .mk-star:focus-visible { outline: 1px solid var(--m-acc); outline-offset: -8px; }
+html.m-sky .mk-say { display: block; position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+
+/* fold 2 · services */
+html.m-sky .sv5-list { position: relative; isolation: isolate; }
+html.m-sky :is(.sv5-card, .sv5-head, .sv5-panel, .sv5-art) { border-color: transparent !important; background: transparent !important; box-shadow: none !important; }
+html.m-sky .sv5-head::before, html.m-sky .sv5-card h3::before { content: none !important; }
+html.m-sky .sv5-head::after { border-color: rgba(251,250,245,.5); border-radius: 0; background: linear-gradient(var(--ink), var(--ink)) 50% / 12px 1px no-repeat, linear-gradient(var(--ink), var(--ink)) 50% / 1px 12px no-repeat; }
+html.m-sky .sv5-card.on .sv5-head::after { background: linear-gradient(var(--ink), var(--ink)) 50% / 12px 1px no-repeat; }
+html.m-sky .sv5-art svg { visibility: hidden; }
+html.m-sky .sv5-h, html.m-sky .sec h2 { font-weight: 400; letter-spacing: -.03em; }
+html.m-sky .sv5-h em { font-style: normal; font-weight: 700; text-shadow: 0 0 .3em rgba(251,250,245,.5); }
+html.m-sky .sv5-card h3, html.m-sky .sv5-card h3 button { font-weight: 400; letter-spacing: -.02em; }
+html.m-sky .sv5-card .sv5-head { color: var(--m-dim); transition: color .1s steps(2, end); }
+html.m-sky .sv5-card:is(.on, :hover) .sv5-head { color: var(--ink); }
+html.m-sky .sv5-card.on h3 button { font-weight: 700; }
+html.m-sky .sv5-card .sv5-when .mono, html.m-sky .sv5-card.on .sv5-when .mono { color: var(--m-dim); }
+html.m-sky .sv5-when { font-weight: 400; }
+html.m-sky .sv5-lead, html.m-sky .sv5-body .sv5-p { color: var(--muted); }
+
+/* fold 4 · the streets are galaxies: a scene as tall as the screen, the figure in the street's colour in its own
+   field of stars, the name and the words inside the scene, no card. The work follows underneath. */
+html.m-sky .streets-nav { border: 0; border-bottom: 1px solid rgba(251,250,245,.2); border-radius: 0; background: #0d0c09; box-shadow: none; }
+html.m-sky .streets-nav a { background: transparent !important; box-shadow: none; border-color: transparent; border-radius: 0; color: var(--m-dim); font-weight: 400; }
+html.m-sky .streets-nav a:hover, html.m-sky .streets-nav a[aria-current] { color: var(--ink); }
+html.m-sky .streets-nav a[aria-current] { font-weight: 700; box-shadow: inset 0 -1px 0 var(--m-acc); }
+html.m-sky .streets-nav .sn-ico { width: 12px; height: 12px; border: 0; border-radius: 0; background: var(--dc) !important; box-shadow: 0 0 10px var(--dc); }
+html.m-sky .streets-nav .sn-ico svg { display: none; }
+html.m-sky .streets-nav::before { background: linear-gradient(90deg, #0d0c09 25%, rgba(13,12,9,0)); }
+html.m-sky .streets-nav::after { background: linear-gradient(270deg, #0d0c09 25%, rgba(13,12,9,0)); }
+html.m-sky :is(.sb-media, .sb-veil, .sb-copy, .street-head .sb-pp) { display: none !important; }
+html.m-sky .dom-street { display: grid; grid-template-columns: minmax(0, 1fr); margin-top: 0; }
+html.m-sky .street-band { grid-area: 1 / 1; height: auto; min-height: calc(100svh - 150px); margin: 0; overflow: visible; contain: none; isolation: auto; pointer-events: none; }
+html.m-sky .sb-stage { isolation: isolate; overflow: visible; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
+html.m-sky .dom-street .street-head { grid-area: 1 / 1; align-self: center; display: block; max-width: min(46%, 560px); margin: 0; padding: 0; border: 0; border-radius: 0; background: none; box-shadow: none; color: var(--ink); scale: none; z-index: 2; }
+html.m-sky .street-head .street-sign { position: static; display: block; width: auto; height: auto; margin: 0; padding: 0; border: 0; border-radius: 0; overflow: visible; clip-path: none; translate: none; rotate: none; transform: none; background: none; box-shadow: none; color: var(--ink); white-space: normal; max-width: none; }
+html.m-sky .street-head .street-sign::before { content: none; }
