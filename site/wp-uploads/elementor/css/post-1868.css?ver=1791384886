input[type="checkbox"] + label {
  display: inline-block!important;
  padding: 6px 20px;
  margin-bottom: 10px !important;
  background-color: #FFD147;
  color: #121212;
  border: 1px solid #121212;
  border-radius: 3em;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

